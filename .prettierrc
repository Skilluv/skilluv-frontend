{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"semi": true,
	"plugins": ["prettier-plugin-svelte"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": { "parser": "svelte" }
		},
		{
			"files": ["*.json", "*.jsonc", "*.yml", "*.yaml"],
			"options": { "useTabs": false, "tabWidth": 2 }
		},
		{
			"files": "*.md",
			"options": { "useTabs": false, "tabWidth": 2, "proseWrap": "preserve" }
		}
	]
}
