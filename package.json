{
  "name": "skilluv-frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "i18n:check": "node scripts/i18n-check.mjs",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "eslint src tests --fix",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "audit:axe": "node scripts/axe-audit.mjs",
    "security:html": "bash scripts/check-html-sinks.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "4.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.69.0",
    "@sentry/sveltekit": "^10.74.0",
    "@simplewebauthn/browser": "^14.0.0",
    "gsap": "^3.15.1",
    "posthog-js": "^1.447.1"
  },
  "overrides": {
    "cookie": "^0.7.0",
    "dompurify": "^3.4.13"
  }
}
