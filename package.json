{
	"name": "skilluv-frontend",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "playwright test",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"i18n:check": "node scripts/i18n-check.mjs",
		"lint": "eslint src tests",
		"lint:fix": "eslint src tests --fix",
		"audit:lighthouse": "node scripts/lighthouse-audit.mjs",
		"audit:axe": "node scripts/axe-audit.mjs",
		"security:html": "bash scripts/check-html-sinks.sh"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.4.0",
		"chrome-launcher": "^1.2.1",
		"eslint": "^10.9.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jsdom": "^30.0.1",
		"lighthouse": "^13.4.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"tailwindcss": "4.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vite-bundle-visualizer": "^1.2.1",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@lucide/svelte": "^1.34.0",
		"@sentry/sveltekit": "^10.71.0",
		"@simplewebauthn/browser": "^13.3.0",
		"gsap": "^3.15.0",
		"monaco-editor": "^0.56.0",
		"posthog-js": "^1.422.1"
	},
	"overrides": {
		"cookie": "^0.7.0",
		"dompurify": "^3.4.13"
	}
